# ==============================================================================
# MonQuest  —  environment variables
# Code blocks consult .env.example? No: they read `.env.local` (dev) or the
# deployment's env store. Copy this file to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# The server validates required vars at startup (app/lib/env.ts) and throws a
# descriptive MissingEnvError if any are missing.
# ==============================================================================

# ── Vercel deployment ─────────────────────────────────────────────────────────
# Production reads these from Vercel → Project → Settings → Environment
# Variables — NOT from this file. The NEXT_PUBLIC_* values are inlined at BUILD
# time (they must exist before `next build` runs, or compilation-related init
# like the Privy/Supabase providers can fail). Server-only keys
# (SUPABASE_SERVICE_ROLE_KEY, GOOGLE_GEMINI_API_KEY, SOLANA_PRIVATE_KEY) are
# read at runtime and never shipped to the browser.
# ==============================================================================

# ── Privy (SSO + embedded wallets) ───────────────────────────────────────────
# Dashboard: https://dashboard.privy.io → your app → "Keys" tab.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id            # pub_... (public, safe)
NEXT_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id      # client_... (public, safe)

# Platform fee recipient for the x402 bounty flow (your own wallet).
# The bounty platform fee (0.001 SOL on Solana devnet) is sent here.
# Must be a base58 Solana address. When unset, the app uses a devnet placeholder.
NEXT_PUBLIC_PLATFORM_WALLET=your_solana_platform_wallet_address

# ── Supabase (Postgres + Storage) ────────────────────────────────────────────
# Project Settings → API. The two public values are inlined in the client;
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY (never NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Google Gemini (AI bounty judging) ────────────────────────────────────────
# https://aistudio.google.com/apikey  (server-only)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# ── Solana (bounty + x402 payments) ─────────────────────────────────────────
# Chain used for the x402 payment verification + winner payouts. Defaults to
# Solana devnet (https://api.devnet.solana.com). Some wallet apps (Phantom)
# also serve a public devnet RPC — keep the default unless you self-host.
#SOLANA_RPC_URL=https://api.devnet.solana.com

# Prize currency shown across the UI (native token of the payment chain).
NEXT_PUBLIC_PRIZE_CURRENCY=SOL

# ── Wallets page (multi-chain; bonus surface, not used by bounty flow) ───────
# The Wallets page also surfaces EVM / Solana / BTC balances. These are all
# optional. Defaults: Ethereum mainnet, Solana devnet, BTC mainnet.
#EVM_RPC_URL=https://cloudflare-eth.com
#EVM_CHAIN_ID=1
#SOLANA_RPC_URL=https://api.devnet.solana.com
#BTC_NETWORK=mainnet

# ── Scripts / CLI (local anvil + solana-test-validator) ─────────────────────
# Only needed when running scripts/demo. Must NOT be shipped to the browser.
#EVM_RPC_URL=http://127.0.0.1:8545
#PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#EVM_TOKEN_LIST=0x5FbDB2315678afecb367f032d93F642f64180aa3:MQ:18
#SOLANA_PRIVATE_KEY=your_64_byte_base58_solana_secret_key